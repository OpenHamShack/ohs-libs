{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://openhamshack.org/schemas/ui2.schema.json",
 "title": "ui/2: server-driven screens (openhamshack docs/contract/SCREENS.md)",
 "description": "The structure of a ui/2 screen document and the messages around it: the live socket's frames and ops (§4), a poll answer, a call's answer (§5.3), an app's descriptor and status (§1) and a symbol set file (§3.6). The root is a document; the other shapes are $defs to $ref directly. The schema is the shape a client can parse plus the rules expressible as shape: relative paths (§11), the transmit rules (§7: level transmit only with tx and a lease, an item's action never transmit, ptt and txArm with no action and no timing but holdMs >= 1000), the action kinds and their fields. Unknown properties, part types, layer kinds and ops are allowed, because a client degrades on them (§2.3). What needs the whole document (ids that exist, a lease naming a ptt, bindings only inside templates, ids used once, the cross-app open, a call to a key route) is check.py's, in shack_ui, and each port's: spec/vectors/ui2/documents.json gives both verdicts for every case.",
 "$ref": "#/$defs/document",
 "$defs": {
  "document": {
   "type": "object",
   "required": [
    "ui",
    "screen",
    "root"
   ],
   "properties": {
    "ui": {
     "type": "string",
     "pattern": "^2\\.[0-9]+$"
    },
    "screen": {
     "type": "string"
    },
    "rev": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "form": {
     "type": "string"
    },
    "level": {
     "enum": [
      "view",
      "control",
      "transmit"
     ]
    },
    "colors": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/color"
     }
    },
    "symbols": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/symbol"
     }
    },
    "words": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "collections": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/collection"
     }
    },
    "selections": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "from"
      ],
      "properties": {
       "from": {
        "type": "string"
       }
      }
     }
    },
    "holds": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/hold"
     }
    },
    "live": {
     "type": "object",
     "required": [
      "path"
     ],
     "properties": {
      "path": {
       "type": "string",
       "minLength": 1,
       "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
      }
     }
    },
    "poll": {
     "$ref": "#/$defs/poll"
    },
    "keys": {
     "$ref": "#/$defs/keys"
    },
    "backdrop": {
     "type": "object",
     "properties": {
      "style": {
       "type": "string"
      },
      "image": {
       "anyOf": [
        {
         "type": "null"
        },
        {
         "$ref": "#/$defs/binding"
        },
        {
         "type": "string",
         "minLength": 1,
         "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
        },
        {
         "type": "string",
         "pattern": "^https://([A-Za-z0-9-]+\\.)*plnspttrs\\.net(:\\d+)?(/|$)"
        }
       ]
      },
      "dim": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      }
     }
    },
    "root": {
     "$ref": "#/$defs/part"
    }
   }
  },
  "part": {
   "type": "object",
   "required": [
    "type"
   ],
   "properties": {
    "type": {
     "type": "string",
     "minLength": 1
    },
    "id": {
     "type": "string",
     "minLength": 1
    },
    "forms": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "hidden": {
     "type": "boolean"
    },
    "weight": {
     "type": "number"
    },
    "w": {
     "type": "number"
    },
    "h": {
     "type": "number"
    },
    "maxW": {
     "type": "number"
    },
    "maxH": {
     "type": "number"
    },
    "surface": {
     "type": "string"
    },
    "back": {
     "$ref": "#/$defs/actionOrBinding"
    },
    "keys": {
     "$ref": "#/$defs/keys"
    },
    "hero": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "$ref": "#/$defs/binding"
      }
     ]
    },
    "since": {
     "type": "string",
     "pattern": "^2\\.[0-9]+$"
    },
    "fallback": {
     "$ref": "#/$defs/part"
    },
    "children": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/part"
     }
    },
    "child": {
     "$ref": "#/$defs/part"
    },
    "template": {
     "$ref": "#/$defs/part"
    },
    "empty": {
     "$ref": "#/$defs/part"
    },
    "overlay": {
     "$ref": "#/$defs/part"
    },
    "action": {
     "$ref": "#/$defs/actionOrBinding"
    },
    "onActivate": {
     "$ref": "#/$defs/actionOrBinding"
    },
    "onHold": {
     "$ref": "#/$defs/actionOrBinding"
    },
    "onClose": {
     "$ref": "#/$defs/actionOrBinding"
    },
    "from": {
     "type": "string"
    },
    "for": {
     "type": "string"
    },
    "selection": {
     "type": "string"
    },
    "label": {
     "$ref": "#/$defs/value"
    },
    "poll": {
     "$ref": "#/$defs/poll"
    }
   },
   "description": "§3. Unknown properties are allowed (a newer server may add one and a client ignores it), and so is an unknown type: a client draws its fallback or a placeholder (§2.3). check.py's unknown_part is the server's own rule, not the schema's.",
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "text"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [],
      "properties": {
       "value": {
        "$ref": "#/$defs/value"
       },
       "style": {
        "type": "string"
       },
       "lines": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "field"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [],
      "properties": {
       "label": {
        "$ref": "#/$defs/value"
       },
       "value": {
        "$ref": "#/$defs/value"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "badge"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [],
      "properties": {
       "text": {
        "$ref": "#/$defs/value"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "progress"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [],
      "properties": {
       "value": {
        "$ref": "#/$defs/value"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "image"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [],
      "properties": {
       "src": {
        "anyOf": [
         {
          "type": "null"
         },
         {
          "$ref": "#/$defs/binding"
         },
         {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
         },
         {
          "type": "string",
          "pattern": "^https://([A-Za-z0-9-]+\\.)*plnspttrs\\.net(:\\d+)?(/|$)"
         }
        ]
       },
       "link": {
        "anyOf": [
         {
          "type": "string",
          "pattern": "^https://[^/?#]+"
         },
         {
          "$ref": "#/$defs/binding"
         }
        ]
       },
       "refreshS": {
        "type": "number",
        "exclusiveMinimum": 0
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "audio"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "src"
      ],
      "properties": {
       "src": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "video"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "src"
      ],
      "properties": {
       "src": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "camera"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "srt"
      ],
      "properties": {
       "srt": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "tile"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [],
      "properties": {
       "art": {
        "anyOf": [
         {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
         },
         {
          "$ref": "#/$defs/binding"
         }
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "list"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [],
      "properties": {
       "follow": {
        "enum": [
         "top"
        ]
       },
       "keepFocus": {
        "type": "boolean"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "table"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "columns"
      ],
      "properties": {
       "columns": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "value"
         ]
        }
       },
       "page": {
        "$ref": "#/$defs/poll"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "panel"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [],
      "properties": {
       "slot": {
        "type": "string"
       },
       "step": {
        "type": "boolean"
       },
       "open": {
        "type": "boolean"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "split"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [],
      "properties": {
       "children": {
        "maxItems": 2
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "tabs"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "tabs"
      ],
      "properties": {
       "tabs": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "id"
         ],
         "properties": {
          "child": {
           "$ref": "#/$defs/part"
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "frame"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "w",
       "h"
      ],
      "properties": {
       "w": {
        "type": "number"
       },
       "h": {
        "type": "number"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "map"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [],
      "properties": {
       "ground": {
        "type": "object",
        "properties": {
         "tiles": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
         },
         "land": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
         }
        }
       },
       "layers": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/layer"
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "spectrum"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "stream"
      ],
      "properties": {
       "stream": {
        "type": "object",
        "required": [
         "path"
        ],
        "properties": {
         "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
         }
        }
       },
       "tap": {
        "$ref": "#/$defs/action"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "chart"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "marks"
      ],
      "properties": {
       "marks": {
        "type": "array",
        "items": {
         "type": "object"
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "ptt"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "key"
      ],
      "properties": {
       "key": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
       },
       "heartbeat": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
       },
       "keep": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
       },
       "holdMs": {
        "type": "number",
        "minimum": 1000
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "ptt"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "propertyNames": {
       "not": {
        "pattern": "^(?!holdMs$)[a-z][A-Za-z]*(Ms|S)$"
       }
      },
      "not": {
       "anyOf": [
        {
         "required": [
          "action"
         ]
        },
        {
         "required": [
          "onHold"
         ]
        },
        {
         "required": [
          "onActivate"
         ]
        },
        {
         "required": [
          "tap"
         ]
        }
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "txArm"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "arm"
      ],
      "properties": {
       "arm": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
       },
       "heartbeat": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?(\\.\\.|%2[eE]%2[eE]|\\.%2[eE]|%2[eE]\\.)(/|\\?|$)).*$"
       },
       "digital": {
        "type": "boolean"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "txArm"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "propertyNames": {
       "not": {
        "pattern": "^[a-z][A-Za-z]*(Ms|S)$"
       }
      },
      "not": {
       "anyOf": [
        {
         "required": [
          "action"
         ]
        },
        {
         "required": [
          "onHold"
         ]
        },
        {
         "required": [
          "onActivate"
         ]
        },
        {
         "required": [
          "tap"
         ]
        }
       ]
      }
     }
    }
   ]
  },
  "layer": {
   "type": "object",
   "required": [
    "kind"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "description": "markers, lines, polygons, rings, images; an unknown kind is not drawn"
    },
    "from": {
     "type": "string"
    },
    "selection": {
     "type": "string"
    },
    "items": {
     "type": "array"
    }
   }
  },
  "value": {
   "description": "§2.1: a literal (already localised), a typed value, {\"$\": field} inside a template, a local preference, or a list of values drawn joined. A dict is read as the first of these it matches; one that names a typed kind must be that kind's shape.",
   "anyOf": [
    {
     "type": [
      "string",
      "number",
      "boolean",
      "null"
     ]
    },
    {
     "type": "array",
     "items": {
      "$ref": "#/$defs/value"
     }
    },
    {
     "$ref": "#/$defs/binding"
    },
    {
     "$ref": "#/$defs/local"
    },
    {
     "type": "object",
     "allOf": [
      {
       "if": {
        "required": [
         "freq"
        ]
       },
       "then": {
        "properties": {
         "freq": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "$ref": "#/$defs/binding"
           }
          ]
         },
         "unit": {
          "type": "string"
         },
         "decimals": {
          "type": "integer",
          "minimum": 0
         }
        }
       }
      },
      {
       "if": {
        "required": [
         "ago"
        ]
       },
       "then": {
        "properties": {
         "ago": {
          "anyOf": [
           {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d(:\\d\\d(\\.\\d+)?)?(Z|[+-]\\d\\d:\\d\\d)$"
           },
           {
            "$ref": "#/$defs/binding"
           }
          ]
         }
        }
       }
      },
      {
       "if": {
        "required": [
         "since"
        ]
       },
       "then": {
        "properties": {
         "since": {
          "anyOf": [
           {
            "type": "string",
