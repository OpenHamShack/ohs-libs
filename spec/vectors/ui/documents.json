{
  "description": "ui/1 screen documents (CLIENT-UI-PLAN.md §5) and what a validator must say: ok, or the named error. Every error case is also invalid against spec/schemas/ui.schema.json, so a client that only runs the schema refuses the same documents; the names are what shack_ui (and any port that names errors) reports, checked node by node, depth first, in this order: unknown_component, unknown_native, transmit_component_action, unknown_action, transmit_action, then the schema (schema).",
  "version": 1,
  "cases": [
    {"id": "plan-example", "document": {"ui": "1.0", "screen": "radio/home", "rev": "b13-4f2a", "title": "Radio", "data": {"state": "ws:api/events?kinds=state,meter", "stations": "get:api/dab/stations"}, "root": {"c": "column", "children": [{"c": "nowPlaying", "title": {"bind": "state.dab.service"}, "subtitle": {"bind": "state.dab.dls"}, "image": {"bind": "state.dab.slideUrl"}}, {"c": "native", "name": "waterfall", "v": 1, "props": {"stream": "main", "layers": ["band", "dial", "stations"]}, "fallback": {"c": "text", "text": "This needs a newer OpenHamShack app."}}, {"c": "row", "children": [{"c": "button", "label": "Scan", "icon": "scan", "action": {"do": "post", "path": "api/dab/scan", "level": "control"}}, {"c": "slider", "label": "Volume", "value": {"bind": "state.volume"}, "min": 0, "max": 1, "action": {"do": "post", "path": "api/set", "body": {"volume": "$value"}, "level": "control"}}]}]}}, "expect": {"ok": true}, "note": "§5.2's example, unchanged"},
    {"id": "every-action", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "column", "children": [{"c": "button", "label": "Go", "action": {"do": "open", "screen": "radio/dab", "params": {"band": "III"}}}, {"c": "button", "label": "Go", "action": {"do": "back"}}, {"c": "button", "label": "Go", "action": {"do": "local", "key": "layers.spots", "value": false}}, {"c": "button", "label": "Go", "action": {"do": "native", "verb": "waterfall.zoomIn"}}, {"c": "button", "label": "Go", "action": {"do": "confirm", "text": "Stop the scan?", "action": {"do": "post", "path": "api/dab/stop", "level": "control"}}}]}}, "expect": {"ok": true}},
    {"id": "ptt-placed", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "row", "children": [{"c": "native", "name": "enableTx", "v": 1}, {"c": "native", "name": "ptt", "v": 1, "tv": false}]}}, "expect": {"ok": true}, "note": "the server places ptt/enableTx; their behaviour is client code"},
    {"id": "polled-feed", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "value", "value": {"bind": "status.vfo", "format": "freq"}}, "data": {"status": {"src": "get:api/status", "poll": 5}}}, "expect": {"ok": true}},
    {"id": "unknown-property-ignored", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "text", "text": "hi", "sparkle": true}}, "expect": {"ok": true}, "note": "§5.3: unknown properties are ignored, so a newer server can add one"},
    {"id": "transmit-post", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "button", "label": "Go", "action": {"do": "post", "path": "api/tx", "level": "transmit"}}}, "expect": {"error": "transmit_action"}, "note": "§5.6: no generic action may transmit"},
    {"id": "transmit-in-confirm", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "button", "label": "Go", "action": {"do": "confirm", "text": "Key up?", "action": {"do": "post", "path": "api/ptt", "level": "transmit"}}}}, "expect": {"error": "transmit_action"}, "note": "wrapping it in a question does not make it allowed"},
    {"id": "transmit-in-fallback", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "native", "name": "waterfall", "v": 1, "fallback": {"c": "button", "label": "Go", "action": {"do": "post", "path": "api/tx", "level": "transmit"}}}}, "expect": {"error": "transmit_action"}},
    {"id": "ptt-with-action", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "native", "name": "ptt", "v": 1, "action": {"do": "post", "path": "api/ptt", "level": "control"}}}, "expect": {"error": "transmit_component_action"}, "note": "ptt/enableTx take no generic action, whatever its level"},
    {"id": "unknown-component", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "marquee", "text": "hi"}}, "expect": {"error": "unknown_component"}, "note": "a closed vocabulary: the server sends a fallback instead"},
    {"id": "unknown-native", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "native", "name": "spectrumAnalyser", "v": 1}}, "expect": {"error": "unknown_native"}},
    {"id": "unknown-action", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "button", "label": "Go", "action": {"do": "eval", "code": "1"}}}, "expect": {"error": "unknown_action"}},
    {"id": "absolute-path", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "button", "label": "Go", "action": {"do": "post", "path": "/api/set", "level": "control"}}}, "expect": {"error": "schema"}, "note": "relative to the app's base, never absolute"},
    {"id": "post-without-level", "document": {"ui": "1.0", "screen": "test/screen", "root": {"c": "button", "label": "Go", "action": {"do": "post", "path": "api/set"}}}, "expect": {"error": "schema"}, "note": "every post declares its level"},
    {"id": "ui-2", "document": {"ui": "2.0", "screen": "radio/home", "rev": "b13-4f2a", "title": "Radio", "data": {"state": "ws:api/events?kinds=state,meter", "stations": "get:api/dab/stations"}, "root": {"c": "column", "children": [{"c": "nowPlaying", "title": {"bind": "state.dab.service"}, "subtitle": {"bind": "state.dab.dls"}, "image": {"bind": "state.dab.slideUrl"}}, {"c": "native", "name": "waterfall", "v": 1, "props": {"stream": "main", "layers": ["band", "dial", "stations"]}, "fallback": {"c": "text", "text": "This needs a newer OpenHamShack app."}}, {"c": "row", "children": [{"c": "button", "label": "Scan", "icon": "scan", "action": {"do": "post", "path": "api/dab/scan", "level": "control"}}, {"c": "slider", "label": "Volume", "value": {"bind": "state.volume"}, "min": 0, "max": 1, "action": {"do": "post", "path": "api/set", "body": {"volume": "$value"}, "level": "control"}}]}]}}, "expect": {"error": "schema"}, "note": "ui 2 is a different contract"}
  ]
}
