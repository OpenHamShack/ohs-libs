  "notes": [
    {"topic": "class-n", "text": "Class N's bands and power have not been published (DM 26 January 2026 leaves them to a later decree): OpenHamShack refuses every transmission for it until they are.", "src": "DMN Art. 1 c.4, Art. 4"},
    {"topic": "experimental", "text": "ARI's portal gives CW and narrow modes for 1810-1830 kHz and 3 kHz at most for 40.660-40.700 MHz; that is ARI's statement, not MIMIT's letter, and is not enforced.", "src": "it.md s.3 (secondary)"},
    {"topic": "unattended", "text": "Unattended repeaters: 10 W ERP at most, callsign every 10 minutes, carrier only while a signal is present.", "src": "A26 Art. 9"},
    {"topic": "beacon", "text": "Beacons are identified by the callsign followed by /B.", "src": "CCE art. 143 c.4"},
    {"topic": "airborne", "text": "Portable and mobile operation excludes aircraft.", "src": "CCE art. 134 c.2"},
    {"topic": "identification", "text": "Identify at the start and end of each contact and every 10 minutes.", "src": "A26 Art. 12 c.6"}
  ],
