  "ceptSrc": "BEK nr. 499/2026 § 15 stk. 2, § 16, § 19 stk. 2; CEPT T/R 61-01 Annex 2 (16 Feb 2024) p.5; ECC/REC/(05)06 Annex 2 p.5",
  "ceptVisitor": {},
  "notes": [
    {"topic": "category-d", "text": "Category D may use only factory-built radio equipment that is not exempt from the radio equipment rules (CE-marked): not a home-built transmitter or a software-defined radio used as one.", "src": "D1 Bilag 4 pkt. 3.1 nr. 5 p.17"},
    {"topic": "supervised", "text": "A Category B holder may use Category A powers, and a Category D holder Category B or A frequencies and powers, under the physical supervision of a holder of that category.", "src": "D1 Bilag 4 pkt. 3.1 nr. 3-4"},
    {"topic": "eme", "text": "On 1298-1300 MHz Categories A and B may use 500 W with an antenna of at least 30 dBi at 15 degrees elevation or more; OpenHamShack holds 160 W.", "src": "D1 Bilag 4 1.1 note 3"},
    {"topic": "identification", "text": "Give the call sign at the start and end of each contact and at least every ten minutes.", "src": "D1 Bilag 4 pkt. 3.1 nr. 1"},
    {"topic": "encryption", "text": "No encryption on international contacts (including Greenland and the Faroes) or on the repeater and satellite bands.", "src": "D1 Bilag 4 pkt. 3.3 nr. 4 p.18"},
    {"topic": "unattended", "text": "Beacons, digipeaters and repeaters are limited to listed sub-bands at 100 W (A, B) or 50 W (D), 25 W on 4 m.", "src": "D1 Bilag 4 1.2-1.4 pp.14-16"}
  ],
