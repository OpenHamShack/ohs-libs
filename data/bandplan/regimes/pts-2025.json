  "notes": [
    {"topic": "identification", "text": "Send the call sign at the start and end of each contact, and repeat it at short intervals while it continues.", "src": "P1 27 § p.14"},
    {"topic": "ce-marking", "text": "An entry certificate may be used only with CE-marked transmitters: not a home-built or modified one, nor a software-defined radio not marked as an amateur transmitter.", "src": "P1 49 § p.17"},
    {"topic": "unattended", "text": "An entry certificate gives no right to automatic stations or remote control.", "src": "P1 49 § p.17"},
    {"topic": "automatic", "text": "Beacons, repeaters and position transmitters must identify regularly with the responsible person's call sign.", "src": "P1 27 § p.14"},
