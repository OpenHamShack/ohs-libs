  "notes": [
    {"topic": "identification", "text": "Give the full call sign at the start and end of a transmission, and at short intervals during it.", "src": "N1 § 7"},
    {"topic": "interference", "text": "If transmitting causes interference, output power must be reduced to at most 100 W.", "src": "N1 § 7"},
    {"topic": "ny-alesund", "text": "The regulation does not apply to 2-32 GHz within 20 km of Ny-Ålesund (Svalbard): no amateur transmission there.", "src": "N1 § 2"},
    {"topic": "eme", "text": "1000 W may be used for EME and meteor scatter on 4 m, 2 m, 70 cm and 23 cm (to 2027) with a directional antenna and a log of time, azimuth and elevation; OpenHamShack holds the ordinary limit.", "src": "N1 § 5a"},
    {"topic": "training", "text": "A restricted licensee may transmit under Full conditions while a Full licensee is present and supervising.", "src": "N1 § 6"},
    {"topic": "airborne", "text": "No transmission from unmanned aircraft, except organised emergency communication and experimental telemetry at 100 mW EIRP at most.", "src": "N1 § 7"},
    {"topic": "encryption", "text": "Encryption is prohibited, except for organised emergency communication and training for it.", "src": "N1 § 8"}
  ],
