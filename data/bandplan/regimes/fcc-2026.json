  "notes": [
    {"topic": "repeater", "text": "Repeaters may not operate on 28.0-29.5, 50.0-51.0, 144.0-144.5, 145.5-146.0, 222.00-222.15, 431.0-433.0 or 435.0-438.0 MHz.", "src": "47 CFR 97.205"},
    {"topic": "beacon", "text": "Beacons: at most 100 W, one channel per band; automatic control only in the segments 97.203 lists.", "src": "47 CFR 97.203"},
    {"topic": "satellite", "text": "Earth and telecommand stations may use up to 611 W ERP (1 kW EIRP) on 435-438 MHz with the antenna elevated above 10 degrees.", "src": "47 CFR 97.313(f)"},
    {"topic": "spread spectrum", "text": "Spread spectrum is limited to 10 W PEP.", "src": "47 CFR 97.313(j)"},
    {"topic": "visitors", "text": "A Canadian visitor operates on Canadian terms, never beyond Amateur Extra, and signs with the US indicator after the call (VE3ABC/W4).", "src": "47 CFR 97.107(a), 97.119(g)"},
