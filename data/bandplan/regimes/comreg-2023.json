  "notes": [
    {"topic": "mobile", "text": "Mobile (/M) stations may use at most 50 W (17 dBW) PEP, and not within any estuary, dock or harbour or near an airport. Shown, not enforced.", "src": "C1 Note 7 p.27, 5.5"},
    {"topic": "mobile", "text": "4 m mobile operation: the licence says both \"Fixed Operation Only\" and 25 W PEP for mobile use, so OpenHamShack applies the fixed 50 W PEP and does not judge mobile use.", "src": "C1 T3 p.24, Note 7 p.27"},
    {"topic": "maritime", "text": "Maritime mobile (/MM, inland waterways included) is permitted only on 80, 40, 20, 17, 15, 12 and 10 m and 2 m, at most 10 W (10 dBW). Shown, not enforced.", "src": "C1 Note 8 p.27, 5.7"},
    {"topic": "location", "text": "Stations on islands within harbour areas (such as Spike Island) are limited to 50 W (17 dBW) PEP. Shown, not enforced.", "src": "C1 Note 2 p.26"},
    {"topic": "contest", "text": "ComReg's web page allows 1500 W on some HF bands and 1000 W on some VHF/UHF bands during listed contests; it gives no power reference and no dates, so OpenHamShack does not apply it.", "src": "ComReg 'Radio Amateurs' page (modified 2026-05-08)"}
