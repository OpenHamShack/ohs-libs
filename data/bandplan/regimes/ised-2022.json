  "cept": {"T/R 61-01": ["ca_advanced"]},
  "ceptSrc": "RIC-3 Issue 5 s.8.2.1; CEPT T/R 61-01 (18 Oct 2024) Annex 4 Table 2; RBR-4 s.3.2; ECC/REC (05)06 (16 Jun 2023) Annex 4",
  "ceptVisitor": {"T/R 61-01": "ca_advanced"},
  "notes": [
    {"topic": "visitors", "text": "A visitor operates with Basic and Advanced privileges, but never beyond those of their own licence.", "src": "RBR-4 s.3.2"},
    {"topic": "remote", "text": "Holders of Basic may not remote-control a fixed station (RIC-3 policy, which has no status in law; a relaxation is pending).", "src": "RIC-3 s.4.5.1-4.5.2; ca.md s.6"},
    {"topic": "home-built", "text": "Only Advanced holders may install a transmitter or amplifier that is not commercially manufactured; how ISED treats an SDR board with a home-built amplifier is not stated.", "src": "Regs s.44(a); ca.md s.11 item 5"},
    {"topic": "repeater", "text": "A same-band repeater or a club station needs the Advanced qualification.", "src": "Regs s.44(b)"},
    {"topic": "amplifier", "text": "An amplifier must not be capable of exceeding the power limit by more than 3 dB.", "src": "RBR-4 s.10.1"},
    {"topic": "carrier", "text": "Below 30 MHz an unmodulated carrier may be sent only for brief tests.", "src": "RBR-4 s.11"},
    {"topic": "identification", "text": "Identify at the beginning and end of each exchange and at least every 30 minutes, in English or French.", "src": "RBR-4 s.9"},
    {"topic": "60 m", "text": "60 m allows only 2K80J3E, 2K80J2D, 60H0J2B and 150HA1A emissions.", "src": "footnote C21"}
  ],
