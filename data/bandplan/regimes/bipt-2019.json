  "notes": [
    {"topic": "power", "text": "Most Belgian power figures are plain watts with no stated reference (PEP, mean or radiated), so OpenHamShack refuses those bands until the reference is confirmed with BIPT.", "src": "be.md s.3, s.8"},
    {"topic": "atv", "text": "(D)ATV is limited to 200 W EIRP on 433.05-434.79 MHz and 20 W ERP on 1270-1300 MHz, and classes B and C may not send ATV or D-ATV at all.", "src": "B1 Bijl.2 p.16, notes 9-10 p.17"},
    {"topic": "equipment", "text": "Class C holders may not use or keep an external power amplifier.", "src": "B1 §26"},
    {"topic": "pending", "text": "BIPT consulted in 2024 on narrowing 23 cm for class A and opening 1296-1300 MHz to class B; no decision had been published by 2026-10-08.", "src": "B5 pp.6-7"}
  ],
